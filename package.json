{
  "name": "all-str-gen",
  "version": "3.0.2",
  "description": "Generate passwords, usernames, recovery codes, patterns, tokens, PINs and passphrases with cryptographic randomness and zero dependencies.",
  "types": "index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./lib/*": "./lib/*",
    "./words/*": "./words/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matayo-ayo/all-str-gen.git"
  },
  "keywords": [
    "password",
    "password-generator",
    "username",
    "username-generator",
    "passphrase",
    "passphrase-generator",
    "token",
    "token-generator",
    "random-token",
    "alphanumeric",
    "numeric-token",
    "alphabetic-token",
    "pin",
    "pin-generator",
    "recovery-codes",
    "backup-codes",
    "pattern-generator",
    "random-string",
    "string-generator",
    "random-number",
    "uuid",
    "uuid-v4",
    "sha256",
    "hash",
    "cryptographic-random",
    "nodejs",
    "typescript",
    "esm",
    "commonjs",
    "zero-dependencies"
  ],
  "author": "Matayo Ayo",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/matayo-ayo/all-str-gen/"
  },
  "homepage": "https://matayo-ayo.github.io/all-str-gen",
  "files": [
    "lib/",
    "words",
    "index.js",
    "index.d.ts",
    "index.mjs",
    "index.d.mts",
    "scripts/build.js"
  ]
}
